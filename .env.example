# Frontier CAPI developer application.
# Register/approve at https://user.frontierstore.net/ and copy the Client ID
# from the Developer Zone. Never put the shared key (client secret) here:
# a browser-only app must not contain a client secret.
VITE_FRONTIER_CLIENT_ID=

# Must match the redirect URI registered for the application,
# character-for-character (including the trailing slash).
VITE_FRONTIER_REDIRECT_URI=https://edcarrier.threethree.cc/

# Set to true to use generated demo accounts instead of Frontier OAuth.
# Do not enable in production unless you want a demo site.
VITE_MOCK_AUTH=false

# Optional CAPI language for localized strings (en, fr, de, ru, es, pt).
VITE_CAPI_LANGUAGE=en

# Same-origin proxy path served by the Cloudflare Pages Function.
# Override only if you provide the proxy at a different path.
VITE_CAPI_BASE=/api/capi
